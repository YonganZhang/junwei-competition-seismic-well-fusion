# Source-tree caches and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Runtime outputs are excluded by default.  Keep only the canonical portable
# evidence explicitly unignored below.  The HDF5 files live under
# ../../../_data/processed/reservoir/ and are already covered by the project
# root rule `_data/processed/`.
_outputs/**
!_outputs/metrics.json
!_outputs/normalization.json
!_outputs/run_manifest.json
!_outputs/split_manifest.json
!_outputs/loss_curve.png
!_outputs/real_seismic_input.png
!_outputs/test_depth_gt_vs_pred.png

# P5 Stage-2 portable evidence only; raw fold arrays and checkpoints stay ignored.
!_outputs/p5_stage2/
_outputs/p5_stage2/**
!_outputs/p5_stage2/p5_stage2_budget.json
!_outputs/p5_stage2/p5_stage2_split_manifest.json
!_outputs/p5_stage2/p5_stage2_results.jsonl
!_outputs/p5_stage2/p5_stage2_summary.json
!_outputs/p5_stage2/leaderboard_phif.json
!_outputs/p5_stage2/leaderboard_klogh.json
!_outputs/p5_stage2/leaderboard_sw.json
